# Caddy: TLS automático (Let's Encrypt) e proxy reverso.. Domínio vem de infra/.env.prod (DOMAIN).
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy site:3000
}

painel.{$DOMAIN} {
	encode zstd gzip
	reverse_proxy painel:3000
}

# O bot só expõe o webhook do WA-AKG. /health/deps não tem login e não pode ser público.
bot.{$DOMAIN} {
	@webhook path /webhooks/wa-akg
	handle @webhook {
		reverse_proxy bot:3100
	}
	handle {
		respond 404
	}
}
