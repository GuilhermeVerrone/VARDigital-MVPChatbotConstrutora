# Copie para infra/.env.prod na VPS (chmod 600). NUNCA versione.
DOMAIN=exemplo.com.br
# Prefixo das imagens no GHCR, em minúsculas (o deploy define TAG)
IMAGE_PREFIX=ghcr.io/SEU_USUARIO/mvp-construtora
TAG=latest

BOT_DB_PASSWORD=
CHAT_HASH_SECRET=
WA_AKG_WEBHOOK_SECRET=
WA_AKG_API_KEY=
WA_AKG_SESSION_ID=piloto
# Telefones separados por vírgula, ou * para atender e enviar a qualquer número (grupos continuam recusados)
ALLOWED_PHONES=*
ANTHROPIC_API_KEY=
SITE_FORM_SECRET=
SITE_WHATSAPP_NUMBER=

WA_AKG_MYSQL_ROOT_PASSWORD=
WA_AKG_AUTH_SECRET=
WA_AKG_ADMIN_EMAIL=
WA_AKG_ADMIN_PASSWORD=

# Opcionais. Padrões: janela 08:00-20:00 de seg a sáb, 30 primeiros contatos/h, formulário 10/h por IP e 3/h por telefone.
# Sem restrição (teste): START=00:00 END=24:00 DAYS=0-6 MAX_PER_HOUR=0 e os dois SITE_RATE_LIMIT_*=0.
# FIRST_CONTACT_START=08:00
# FIRST_CONTACT_END=20:00
# FIRST_CONTACT_DAYS=1-6
# FIRST_CONTACT_MAX_PER_HOUR=30
# SITE_RATE_LIMIT_IP=10
# SITE_RATE_LIMIT_PHONE=3
