# Copie para infra/.env (ou rode infra/scripts/init-env.sh, que gera segredos aleatórios).
# NUNCA versione infra/.env.

# --- WA-AKG ---
WA_AKG_PORT=3000
WA_AKG_MYSQL_ROOT_PASSWORD=
WA_AKG_AUTH_SECRET=
WA_AKG_SWAGGER_PASSWORD=
WA_AKG_ADMIN_EMAIL=admin@piloto.local
WA_AKG_ADMIN_PASSWORD=
# Preenchido por infra/scripts/wa-akg-bootstrap.sh
WA_AKG_API_KEY=
WA_AKG_SESSION_ID=piloto

# --- Bot ---
BOT_PORT=3100
BOT_LOG_LEVEL=info
BOT_DB_PORT=5433
BOT_DB_PASSWORD=
# Segredo do hash da conversa antes do consentimento (gerado por init-env.sh).
CHAT_HASH_SECRET=
# LLM (fallback dos parsers e FAQ). Os parsers vêm primeiro; sem chave ou com a API fora do ar o bot
# segue só com eles e o /health/deps mostra o LLM como degradado.
LLM_ENABLED=true
# anthropic (padrão, API da Anthropic) | ollama (perfil opcional do compose; exige máquina com ~6 GB livres)
LLM_PROVIDER=anthropic
# Chave da API: SÓ aqui (nunca no código, no log nem em issue). Confira os termos de retenção e de
# treinamento da conta usada antes de ligar com lead real.
ANTHROPIC_API_KEY=
# Vazio = padrão do provedor (claude-haiku-5-5 na Anthropic, qwen2.5:7b no Ollama).
LLM_MODEL=
# Teto de chamadas ao LLM por conversa (custo); depois dele só os parsers.
LLM_MAX_CALLS_PER_CONVERSATION=30
# Telefones que o bot atende e para os quais envia (vírgula). Nada sai para fora desta lista.
# Valor FICTÍCIO: troque pelo número de teste do piloto (obrigatório ter ao menos um).
ALLOWED_PHONES=5511912345678
# Retenção (LGPD): leads sem atividade há mais de N dias são apagados (0 desliga). Padrão: 180.
LEAD_RETENTION_DAYS=180
# Limites de entrada: mensagens por conversa por minuto (0 desliga) e tamanho máximo do texto.
RATE_LIMIT_PER_MIN=30
MAX_TEXT_CHARS=2000
# Os telefones dos CORRETORES (tabela brokers) também precisam estar em ALLOWED_PHONES, senão o
# aviso ao corretor é bloqueado. O seed traz corretores fictícios (DDD 00): troque-os para o piloto.
# Secret HMAC compartilhado com o webhook do WA-AKG (>= 16 caracteres)
WA_AKG_WEBHOOK_SECRET=
# URL do bot vista de dentro da rede Docker (precisa ser https://)
BOT_WEBHOOK_URL=https://bot:3100/webhooks/wa-akg
# Dev: grava payloads brutos (CONTÊM DADOS PESSOAIS). Ex.: /captures
WEBHOOK_CAPTURE_DIR=

# --- Ollama (opcional, desligado por padrão) ---
# Só com LLM_PROVIDER=ollama. macOS: Ollama no host (Docker não usa a GPU) → COMPOSE_PROFILES vazio.
# Linux com RAM sobrando: COMPOSE_PROFILES=ollama e OLLAMA_BASE_URL=http://ollama:11434
COMPOSE_PROFILES=
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_VERSION=0.33.0
OLLAMA_PORT=11435
OLLAMA_SMOKE_MODEL=qwen2.5:7b

# --- Limites de memória por container (VPS de 4 GB; ver docs/fases/fase-11b.md) ---
# WA_AKG_DB_MEM_LIMIT=384m
# WA_AKG_MEM_LIMIT=640m
# BOT_DB_MEM_LIMIT=256m
# BOT_MEM_LIMIT=256m

# --- 1º contato do formulário do site (Fase 13) ---
# Janela de horário (fuso abaixo), dias da semana (0 = domingo) e limite por hora. Fora da janela o job espera.
# FIRST_CONTACT_START=08:00
# FIRST_CONTACT_END=20:00
# FIRST_CONTACT_DAYS=1-6
# FIRST_CONTACT_TIMEZONE=America/Sao_Paulo
# FIRST_CONTACT_MAX_PER_HOUR=30

# Painel (apps/painel, porta 3300)
# PANEL_DATABASE_URL=postgresql://bot:<senha>@127.0.0.1:5433/bot
# PANEL_TRUST_PROXY=true          # só atrás de proxy próprio (usa o último item de X-Forwarded-For)
# PANEL_INSECURE_COOKIES=true     # só para testar build de produção em http local; nunca em produção
# Status do WhatsApp no painel (mesmas variáveis do bot; só leitura)
# WA_AKG_BASE_URL=http://wa-akg:3000
# WA_AKG_API_KEY=
# WA_AKG_SESSION_ID=piloto
