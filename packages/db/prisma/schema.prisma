// Banco do bot (PostgreSQL separado do banco do WA-AKG, decisão D5).
// Modelo de dados: spec.md §10. Identificadores em inglês; tabelas e colunas em snake_case.
// Correspondência com os nomes do spec: packages/db/README.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Leads e conversa
// ---------------------------------------------------------------------------

enum LeadStatus {
  NEW
  IN_PROGRESS
  SIMULATED
  HANDOFF
  DELIVERED
  OPTED_OUT
  CLOSED
}

enum ScoreClass {
  HOT
  WARM
  COLD
}

enum Channel {
  WHATSAPP
  WEB
}

/// De onde o lead veio (V2): formulário do site ou conversa iniciada no WhatsApp.
enum LeadSource {
  SITE_FORM
  WHATSAPP
}

/// Forma de pagamento escolhida (V2, discovery §2): espelha PAYMENT_MODES do motor.
enum PaymentMode {
  A_VISTA
  ENTRADA_A_VISTA
  ENTRADA_PARCELADA
}

enum IncomeType {
  CLT
  AUTONOMO
  SERVIDOR
  APOSENTADO
  OUTROS
}

/// Lead (spec §10). Dados pessoais: só gravados após o consentimento (RF-02, RF-12).
model Lead {
  id         String     @id @default(uuid()) @db.Uuid
  name       String?
  /// Telefone E.164 só com dígitos (ex.: 5511999990000). Chave de deduplicação (RF-41).
  phone      String?    @unique
  /// JID do canal (ex.: 5511...@s.whatsapp.net ou ...@lid quando o telefone não é conhecido).
  channelJid String?    @unique @map("channel_jid")
  email      String?
  birthDate  DateTime?  @map("birth_date") @db.Date
  origin     String?
  campaign   String?
  /// V2: empreendimento de interesse (formulário do site ou escolha no chat).
  developmentId String?  @map("development_id") @db.Uuid
  source     LeadSource @default(WHATSAPP)
  /// V2: parâmetros UTM do formulário ({ source, medium, campaign, ... }).
  utm        Json?
  formSubmittedAt    DateTime? @map("form_submitted_at") @db.Timestamptz(3)
  /// V2: double opt-in — quando o lead confirmou, no WhatsApp, que pediu a simulação.
  contactConfirmedAt DateTime? @map("contact_confirmed_at") @db.Timestamptz(3)
  paymentMode        PaymentMode? @map("payment_mode")
  /// V2: código curto (ELV-4821) do lead do formulário. Casa o lead quando a resposta vem de um @lid.
  contactCode        String?   @unique @map("contact_code")
  status     LeadStatus @default(NEW)
  score      Int?
  scoreClass ScoreClass? @map("score_class")
  brokerId   String?    @map("broker_id") @db.Uuid
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  broker           Broker?            @relation(fields: [brokerId], references: [id], onDelete: SetNull)
  development      Development?       @relation(fields: [developmentId], references: [id], onDelete: SetNull)
  consents         Consent[]
  conversations    Conversation[]
  financialProfile FinancialProfile?
  simulations      Simulation[]
  messages         ProcessedMessage[]
  jobs             DeliveryJob[]

  @@index([brokerId])
  @@index([developmentId])
  @@map("leads")
}

/// Consentimento LGPD versionado (texto, data, canal). Revogar não apaga o registro.
model Consent {
  id          String    @id @default(uuid()) @db.Uuid
  leadId      String    @map("lead_id") @db.Uuid
  textVersion String    @map("text_version")
  channel     Channel
  /// Texto exato mostrado ao lead no aceite (a versão sozinha não prova o que foi aceito).
  textSnapshot String?  @map("text_snapshot")
  acceptedAt  DateTime  @map("accepted_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("consents")
}

model Conversation {
  id           String   @id @default(uuid()) @db.Uuid
  leadId       String   @map("lead_id") @db.Uuid
  channel      Channel
  /// Estado da máquina de estados (Fase 5).
  state        String
  /// Dados coletados na conversa ainda não confirmados (Fase 5).
  context      Json     @default("{}")
  /// Histórico resumido (mensagens) repassado ao corretor no handoff.
  history      Json     @default("[]")
  handoff      Boolean  @default(false)
  /// Código curto do handoff (o corretor responde "assumir <código>"). Preenchido no handoff.
  handoffCode  String?  @unique @map("handoff_code")
  handoffAt    DateTime? @map("handoff_at") @db.Timestamptz(3)
  /// Corretor que assumiu a conversa (null = ainda aguardando alguém).
  takenByBrokerId String? @map("taken_by_broker_id") @db.Uuid
  takenAt      DateTime? @map("taken_at") @db.Timestamptz(3)
  startedAt    DateTime @default(now()) @map("started_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  takenBy Broker? @relation(fields: [takenByBrokerId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([takenByBrokerId])
  @@map("conversations")
}

/// Perfil financeiro informado pelo lead (valores confirmados antes de simular, spec §5.1).
model FinancialProfile {
  id                         String      @id @default(uuid()) @db.Uuid
  leadId                     String      @unique @map("lead_id") @db.Uuid
  grossMonthlyIncome         Decimal     @map("gross_monthly_income") @db.Decimal(14, 2)
  incomeType                 IncomeType  @map("income_type")
  monthlyDebts               Decimal     @default(0) @map("monthly_debts") @db.Decimal(14, 2)
  availableDownPayment       Decimal     @default(0) @map("available_down_payment") @db.Decimal(14, 2)
  fgtsBalance                Decimal?    @map("fgts_balance") @db.Decimal(14, 2)
  fgtsContributionMonths     Int?        @map("fgts_contribution_months")
  ownsResidentialProperty    Boolean     @map("owns_residential_property")
  firstFinancing             Boolean     @map("first_financing")
  coApplicantIncome          Decimal?    @map("co_applicant_income") @db.Decimal(14, 2)
  coApplicantIncomeType      IncomeType? @map("co_applicant_income_type")
  coApplicantBirthDate       DateTime?   @map("co_applicant_birth_date") @db.Date
  coApplicantMonthlyDebts    Decimal?    @map("co_applicant_monthly_debts") @db.Decimal(14, 2)
  coApplicantFgtsBalance     Decimal?    @map("co_applicant_fgts_balance") @db.Decimal(14, 2)
  coApplicantFgtsMonths      Int?        @map("co_applicant_fgts_months")
  /// V2: dinheiro disponível hoje para o ato / a entrada.
  cashNow                    Decimal?    @map("cash_now") @db.Decimal(14, 2)
  /// V2: o lead aceita reforços (intermediárias) na entrada parcelada.
  acceptsBalloons            Boolean?    @map("accepts_balloons")
  updatedAt                  DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("financial_profiles")
}

// ---------------------------------------------------------------------------
// Empreendimentos e unidades
// ---------------------------------------------------------------------------

enum UnitStatus {
  AVAILABLE
  RESERVED
  SOLD
}

model Development {
  id           String   @id @default(uuid()) @db.Uuid
  /// Identificador estável usado pelo seed e pela CLI.
  slug         String   @unique
  name         String
  city         String
  description  String
  deliveryDate DateTime @map("delivery_date") @db.Date
  /// Perguntas frequentes cadastradas: [{ question, answer }] (base do FAQ, Fase 4).
  faq          Json     @default("[]")
  /// Materiais (plantas, book): [{ title, url }].
  materials    Json     @default("[]")
  /// V2: aparece no site público só quando publicado.
  published    Boolean  @default(false)
  heroImage    String?  @map("hero_image")
  address      String?
  /// Destaques do empreendimento: string[].
  highlights   Json     @default("[]")
  /// Galeria: [{ url, alt }].
  gallery      Json     @default("[]")
  /// MVP (legado): fluxo da obra simples. Na V2 estes três campos migram para a condição comercial
  /// (SalesCondition); seguem aqui só para o motor do MVP até a Fase 12.
  signalRatio           Decimal? @map("signal_ratio") @db.Decimal(5, 4)
  balloonRatio          Decimal? @map("balloon_ratio") @db.Decimal(5, 4)
  balloonIntervalMonths Int?     @map("balloon_interval_months")
  /// ILUSTRATIVO enquanto os dados não forem os reais do empreendimento.
  dataStatus   String   @default("ILUSTRATIVO") @map("data_status")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  units           Unit[]
  salesConditions SalesCondition[]
  leads           Lead[]

  @@map("developments")
}

model Unit {
  id            String     @id @default(uuid()) @db.Uuid
  developmentId String     @map("development_id") @db.Uuid
  /// Código da unidade no espelho de vendas (ex.: "A-101").
  code          String
  typology      String
  areaM2        Decimal    @map("area_m2") @db.Decimal(8, 2)
  price         Decimal    @db.Decimal(14, 2)
  status        UnitStatus @default(AVAILABLE)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  development Development  @relation(fields: [developmentId], references: [id], onDelete: Restrict)
  simulations Simulation[]

  @@unique([developmentId, code])
  @@map("units")
}

// ---------------------------------------------------------------------------
// Parâmetros financeiros com vigência (spec §7.5, RF-47, RF-52)
// ---------------------------------------------------------------------------

enum ParameterStatus {
  ILUSTRATIVO
  VALIDADO
}

enum AmortizationSystem {
  SAC
  PRICE
}

enum RateConvention {
  NOMINAL
  EFFECTIVE
}

enum AgeRule {
  OLDEST
  YOUNGEST
}

/// Versão imutável do conjunto de parâmetros. Alterar = criar nova versão (CLI), nunca editar.
/// Vigência em datas inclusivas [valid_from, valid_to]; valid_to nulo = sem fim.
/// Restrição de exclusão (migration) impede duas versões ativas com vigências sobrepostas.
model ParameterSet {
  id                       String             @id @default(uuid()) @db.Uuid
  version                  String             @unique
  status                   ParameterStatus
  validFrom                DateTime           @map("valid_from") @db.Date
  validTo                  DateTime?          @map("valid_to") @db.Date
  defaultSystem            AmortizationSystem @map("default_system")
  adjustmentToleranceRatio Decimal            @map("adjustment_tolerance_ratio") @db.Decimal(9, 8)
  desiredInstallmentToleranceRatio Decimal    @map("desired_installment_tolerance_ratio") @db.Decimal(9, 8)
  highCommitmentAlertRatio Decimal            @map("high_commitment_alert_ratio") @db.Decimal(9, 8)
  informalIncomeTypes      IncomeType[]       @map("informal_income_types")
  /// Versão da qual esta foi derivada (null na primeira importação).
  basedOnId                String?            @map("based_on_id") @db.Uuid
  /// Preenchido quando outra versão com a mesma data de início a substituiu.
  supersededById           String?            @unique @map("superseded_by_id") @db.Uuid
  createdBy                String             @map("created_by")
  note                     String?
  createdAt                DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  basedOn      ParameterSet?  @relation("ParameterSetLineage", fields: [basedOnId], references: [id], onDelete: Restrict)
  derived      ParameterSet[] @relation("ParameterSetLineage")
  supersededBy ParameterSet?  @relation("ParameterSetSuperseded", fields: [supersededById], references: [id], onDelete: Restrict)
  supersedes   ParameterSet?  @relation("ParameterSetSuperseded")
  creditLines  CreditLine[]
  simulations  Simulation[]

  @@index([validFrom])
  @@map("parameter_sets")
}

/// Linha de crédito de uma versão de parâmetros (spec §10 LinhaCredito). A vigência é a da versão.
model CreditLine {
  id                      String               @id @default(uuid()) @db.Uuid
  parameterSetId          String               @map("parameter_set_id") @db.Uuid
  /// Identificador estável entre versões (ex.: "sbpe").
  code                    String
  name                    String
  priority                Int
  maxFamilyIncome         Decimal?             @map("max_family_income") @db.Decimal(14, 2)
  maxPropertyValue        Decimal?             @map("max_property_value") @db.Decimal(14, 2)
  requiresFirstFinancing  Boolean              @map("requires_first_financing")
  requiresNoOwnedProperty Boolean              @map("requires_no_owned_property")
  maxLtv                  Decimal              @map("max_ltv") @db.Decimal(9, 8)
  annualInterestRate      Decimal              @map("annual_interest_rate") @db.Decimal(9, 8)
  rateConvention          RateConvention       @map("rate_convention")
  maxIncomeCommitment     Decimal              @map("max_income_commitment") @db.Decimal(9, 8)
  termMinMonths           Int                  @map("term_min_months")
  termMaxMonths           Int                  @map("term_max_months")
  maxAgeAtEndMonths       Int                  @map("max_age_at_end_months")
  ageRule                 AgeRule              @map("age_rule")
  systems                 AmortizationSystem[]
  /// [{ upToAgeYears, monthlyRate }] em ordem crescente de idade.
  mipMonthlyRateByAge     Json                 @map("mip_monthly_rate_by_age")
  dfiMonthlyRate          Decimal              @map("dfi_monthly_rate") @db.Decimal(12, 10)
  adminFeeMonthly         Decimal              @map("admin_fee_monthly") @db.Decimal(14, 2)
  /// [{ name, amount }]
  otherMonthlyFees        Json                 @default("[]") @map("other_monthly_fees")
  /// { maxPropertyValue, bands: [{ maxFamilyIncome, amount }] } ou null.
  subsidy                 Json?
  /// { allowed, minContributionMonths, maxPropertyValue, requiresNoOwnedProperty }
  fgts                    Json

  parameterSet ParameterSet @relation(fields: [parameterSetId], references: [id], onDelete: Restrict)
  simulations  Simulation[]

  @@unique([parameterSetId, code])
  @@map("credit_lines")
}

// ---------------------------------------------------------------------------
// Condições comerciais com vigência (V2, discovery §2)
// ---------------------------------------------------------------------------

/// Versão imutável das regras comerciais de UM empreendimento (as 3 formas de pagamento). Mesmo
/// padrão do ParameterSet: alterar = publicar nova versão. As regras ficam em `rules` (JSON validado
/// por `salesConditionSchema` do motor); vigência, status e autoria ficam em colunas para o banco
/// garantir a linha do tempo (sem sobreposição por empreendimento) e a imutabilidade.
model SalesCondition {
  id             String          @id @default(uuid()) @db.Uuid
  developmentId  String          @map("development_id") @db.Uuid
  version        String          @unique
  status         ParameterStatus
  validFrom      DateTime        @map("valid_from") @db.Date
  validTo        DateTime?       @map("valid_to") @db.Date
  /// Regras no formato `SalesCondition` do motor, sem version/status/validFrom/validTo.
  rules          Json
  basedOnId      String?         @map("based_on_id") @db.Uuid
  supersededById String?         @unique @map("superseded_by_id") @db.Uuid
  createdBy      String          @map("created_by")
  note           String?
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  development  Development      @relation(fields: [developmentId], references: [id], onDelete: Restrict)
  basedOn      SalesCondition?  @relation("SalesConditionLineage", fields: [basedOnId], references: [id], onDelete: Restrict)
  derived      SalesCondition[] @relation("SalesConditionLineage")
  supersededBy SalesCondition?  @relation("SalesConditionSuperseded", fields: [supersededById], references: [id], onDelete: Restrict)
  supersedes   SalesCondition?  @relation("SalesConditionSuperseded")
  simulations  Simulation[]

  @@index([developmentId, validFrom])
  @@map("sales_conditions")
}

// ---------------------------------------------------------------------------
// Fluxo do bot editável (V2, D11)
// ---------------------------------------------------------------------------

enum FlowConfigStatus {
  DRAFT
  PUBLISHED
  /// Publicada e depois trocada por outra mais nova (continua no histórico).
  RETIRED
}

/// Versão do fluxo do bot: textos por chave, etapas opcionais ligadas/desligadas, botões e 1ª mensagem
/// (`content`, validado na aplicação). Rascunho é editável; publicada é imutável. Sem versão
/// publicada, o bot usa os textos de templates.ts.
model FlowConfig {
  id          String           @id @default(uuid()) @db.Uuid
  /// Sequencial: a publicada de maior número é a vigente.
  version     Int              @unique @default(autoincrement())
  status      FlowConfigStatus @default(DRAFT)
  content     Json
  basedOnId   String?          @map("based_on_id") @db.Uuid
  createdBy   String           @map("created_by")
  note        String?
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt DateTime?        @map("published_at") @db.Timestamptz(3)
  publishedBy String?          @map("published_by")

  basedOn FlowConfig?  @relation("FlowConfigLineage", fields: [basedOnId], references: [id], onDelete: Restrict)
  derived FlowConfig[] @relation("FlowConfigLineage")

  @@index([status])
  @@map("flow_configs")
}

// ---------------------------------------------------------------------------
// Usuários do painel (V2, D8)
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  GERENTE
  CORRETOR
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  email        String    @unique
  /// Hash argon2 (nunca a senha).
  passwordHash String    @map("password_hash")
  role         UserRole
  /// Corretor vinculado (papel CORRETOR vê só os próprios leads).
  brokerId     String?   @unique @map("broker_id") @db.Uuid
  active       Boolean   @default(true)
  failedLogins Int       @default(0) @map("failed_logins")
  lockedUntil  DateTime? @map("locked_until") @db.Timestamptz(3)
  /// Quando o próprio usuário trocou a senha. Nulo = senha definida por outra pessoa (seed ou admin): o painel pede a troca.
  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  broker   Broker?       @relation(fields: [brokerId], references: [id], onDelete: SetNull)
  sessions UserSession[]

  @@map("users")
}

/// Sessão do painel: só o hash do token é guardado.
model UserSession {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

// ---------------------------------------------------------------------------
// Simulação
// ---------------------------------------------------------------------------

enum Verdict {
  VIAVEL
  VIAVEL_COM_AJUSTES
  INVIAVEL
}

model Simulation {
  id                  String              @id @default(uuid()) @db.Uuid
  leadId              String              @map("lead_id") @db.Uuid
  unitId              String?             @map("unit_id") @db.Uuid
  /// Linha escolhida pelo motor (null quando nenhuma é elegível).
  creditLineId        String?             @map("credit_line_id") @db.Uuid
  /// V2: forma de pagamento simulada (null = simulação do MVP, só financiamento).
  paymentMode         PaymentMode?        @map("payment_mode")
  /// V2: versão da condição comercial usada (null no MVP).
  salesConditionId    String?             @map("sales_condition_id") @db.Uuid
  /// V2: plano da entrada (ato, mensais, reforços, chaves) como saiu do motor.
  downPaymentPlan     Json?               @map("down_payment_plan")
  /// V2: estimativa opcional do financiamento do saldo (D10).
  bankEstimate        Json?               @map("bank_estimate")
  system              AmortizationSystem?
  termMonths          Int?                @map("term_months")
  referenceDate       DateTime            @map("reference_date") @db.Date
  propertyValue       Decimal             @map("property_value") @db.Decimal(14, 2)
  financedAmount      Decimal?            @map("financed_amount") @db.Decimal(14, 2)
  requiredDownPayment Decimal?            @map("required_down_payment") @db.Decimal(14, 2)
  subsidy             Decimal?            @db.Decimal(14, 2)
  fgtsUsed            Decimal?            @map("fgts_used") @db.Decimal(14, 2)
  firstInstallment    Decimal?            @map("first_installment") @db.Decimal(14, 2)
  lastInstallment     Decimal?            @map("last_installment") @db.Decimal(14, 2)
  constructionFlow    Json?               @map("construction_flow")
  verdict             Verdict
  /// Versão dos parâmetros usada (spec §10 parametros_versao). Gravada também como FK.
  /// V2: nulo quando o modo não usa o banco (à vista) ou a estimativa está desligada.
  parametersVersion   String?             @map("parameters_version")
  parameterSetId      String?             @map("parameter_set_id") @db.Uuid
  /// Entrada e resultado completos do motor (auditoria e reprodução do cálculo).
  input               Json
  result              Json
  generatedAt         DateTime            @default(now()) @map("generated_at") @db.Timestamptz(3)
  pdfUrl              String?             @map("pdf_url")

  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  unit         Unit?        @relation(fields: [unitId], references: [id], onDelete: SetNull)
  creditLine   CreditLine?  @relation(fields: [creditLineId], references: [id], onDelete: Restrict)
  parameterSet ParameterSet? @relation(fields: [parameterSetId], references: [id], onDelete: Restrict)
  salesCondition SalesCondition? @relation(fields: [salesConditionId], references: [id], onDelete: Restrict)
  jobs         DeliveryJob[]

  @@index([leadId])
  @@index([parameterSetId])
  @@index([salesConditionId])
  @@map("simulations")
}

// ---------------------------------------------------------------------------
// Corretores, auditoria e idempotência do canal
// ---------------------------------------------------------------------------

model Broker {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  /// E.164 só com dígitos.
  phone     String   @unique
  email     String?
  team      String?
  active    Boolean  @default(true)
  /// Escala de atendimento (formato livre no MVP; distribuição avançada é pós-MVP).
  schedule  Json?
  /// Usado pelo round-robin simples (Fase 6).
  lastAssignedAt DateTime? @map("last_assigned_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  leads       Lead[]
  crmContacts CrmContact[]
  taken       Conversation[]
  user        User?

  @@map("brokers")
}

/// Log de auditoria (RF-52). Só inserção; nunca atualizado nem apagado pela aplicação.
model AuditLog {
  /// Sequencial: dá a ordem exata dos eventos (vários na mesma transação têm o mesmo `at`).
  id       BigInt   @id @default(autoincrement())
  /// Quem fez: id do User (painel, V2), usuário da CLI, "seed" ou "system".
  actor    String
  entity   String
  entityId String?  @map("entity_id")
  action   String
  before   Json?
  after    Json?
  reason   String?
  at       DateTime @default(now()) @db.Timestamptz(3)

  @@index([entity, entityId])
  @@index([at])
  @@map("audit_logs")
}

enum InboxStatus {
  PENDING
  PROCESSING
  DONE
  /// Esgotou as tentativas; fica para inspeção manual.
  DEAD
}

/// Fila de entrada (inbox) do canal e idempotência por `key.id` (WA-AKG pode reentregar).
/// O webhook grava aqui e responde; o worker consome (Fase 3). Ao concluir, `payload` é apagado:
/// o conteúdo da mensagem não fica guardado aqui, só os identificadores.
model ProcessedMessage {
  id          String      @id @default(uuid()) @db.Uuid
  channel     Channel
  /// key.id da mensagem no canal.
  externalId  String      @map("external_id")
  sessionId   String      @map("session_id")
  /// Conversa de origem (remoteJid): mensagens da mesma conversa são processadas em ordem.
  chatKey     String      @map("chat_key")
  leadId      String?     @map("lead_id") @db.Uuid
  status      InboxStatus @default(PENDING)
  /// Mensagem normalizada, enquanto não processada. Contém dados pessoais.
  payload     Json?
  attempts    Int         @default(0)
  /// Não reivindicar antes disso (backoff entre tentativas).
  availableAt DateTime    @default(now()) @map("available_at") @db.Timestamptz(3)
  /// Reserva do worker; vencida = o worker caiu e outro pode retomar.
  lockedUntil DateTime?   @map("locked_until") @db.Timestamptz(3)
  lastError   String?     @map("last_error")
  receivedAt  DateTime    @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt DateTime?   @map("processed_at") @db.Timestamptz(3)

  lead Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@unique([channel, sessionId, externalId])
  @@index([status, availableAt])
  @@index([chatKey, receivedAt])
  @@map("processed_messages")
}

/// Estado de quem ainda NÃO consentiu (RF-02, RF-12): guarda só um hash (HMAC) da conversa e o
/// estado, nenhum dado pessoal legível. Some quando o lead aceita (vira Lead + Consent) ou recusa.
/// OPTED_OUT mantém o silêncio de quem pediu para parar antes de consentir.
model ChatSession {
  chatHash  String   @id @map("chat_hash")
  /// CONSENT_ASKED | OPTED_OUT
  state     String
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("chat_sessions")
}

// ---------------------------------------------------------------------------
// CRM simulado e entregas (Fase 6)
// ---------------------------------------------------------------------------

/// Contato no CRM simulado (spec §11: `CrmAdapter`). Fica separado de `leads` de propósito: é o
/// "outro sistema". A chave de deduplicação é o telefone (RF-41); criar duas vezes atualiza.
model CrmContact {
  id            String   @id @default(uuid()) @db.Uuid
  /// E.164 só com dígitos.
  phone         String   @unique
  name          String?
  email         String?
  /// Corretor responsável no CRM (RF-41: lead já existente avisa o responsável).
  ownerBrokerId String?  @map("owner_broker_id") @db.Uuid
  /// Último estado enviado pelo bot (status, classe, empreendimento...), para consulta.
  data          Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner       Broker?         @relation(fields: [ownerBrokerId], references: [id], onDelete: SetNull)
  simulations CrmSimulation[]

  @@index([ownerBrokerId])
  @@map("crm_contacts")
}

/// Simulação anexada a um contato do CRM. `simulationId` é a referência externa: anexar duas
/// vezes a mesma simulação não duplica.
model CrmSimulation {
  id           String   @id @default(uuid()) @db.Uuid
  contactId    String   @map("contact_id") @db.Uuid
  simulationId String   @unique @map("simulation_id") @db.Uuid
  /// Resumo legível (parecer, valores, parâmetros): o que o CRM mostraria ao corretor.
  summary      Json
  attachedAt   DateTime @default(now()) @map("attached_at") @db.Timestamptz(3)

  contact CrmContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@map("crm_simulations")
}

enum JobStatus {
  PENDING
  PROCESSING
  DONE
  /// Esgotou as tentativas (ou erro permanente); fica para inspeção e reenvio manual.
  DEAD
}

/// Fila de entregas de saída (CRM e corretor), em Postgres como a de entrada. Um job por
/// (tipo, simulação): `dedupeKey` único impede enfileirar duas vezes. Só guarda ids, nenhum dado
/// pessoal. Falha enfileira de novo com espera (spec §7.2: nenhum lead se perde).
model DeliveryJob {
  id           String    @id @default(uuid()) @db.Uuid
  /// CRM_SYNC | BROKER_NOTIFY | HANDOFF_NOTIFY | FIRST_CONTACT (V2: 1ª mensagem do formulário do site) | OUTBOX_FLUSH (V2: envia ao lead o que o painel deixou pendente ao devolver o handoff)
  kind         String
  /// Entregas de simulação (CRM_SYNC, BROKER_NOTIFY).
  simulationId String?   @map("simulation_id") @db.Uuid
  /// Entregas de lead sem simulação (HANDOFF_NOTIFY).
  leadId       String?   @map("lead_id") @db.Uuid
  /// Ex.: "BROKER_NOTIFY:<simulationId>"; para reenvios após ajuste, inclui um sufixo.
  dedupeKey    String    @unique @map("dedupe_key")
  /// Parâmetros do job (ex.: { update: true }). Sem dado pessoal.
  payload      Json      @default("{}")
  status       JobStatus @default(PENDING)
  attempts     Int       @default(0)
  availableAt  DateTime  @default(now()) @map("available_at") @db.Timestamptz(3)
  lockedUntil  DateTime? @map("locked_until") @db.Timestamptz(3)
  lastError    String?   @map("last_error")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  processedAt  DateTime? @map("processed_at") @db.Timestamptz(3)

  simulation Simulation? @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  lead       Lead?       @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([leadId])
  @@map("delivery_jobs")
}

// ---------------------------------------------------------------------------
// Exclusão do titular (Fase 7)
// ---------------------------------------------------------------------------

/// Pendência de apagar o histórico do contato no WA-AKG (que guarda as mensagens no banco dele e
/// não tem endpoint para isso). O `chatId` só existe até a limpeza ser feita
/// (`infra/scripts/wa-akg-erase.sh`); depois vira nulo e fica só o registro de que foi feita.
model ErasureTask {
  id          String    @id @default(uuid()) @db.Uuid
  chatId      String?   @map("chat_id")
  /// titular | retencao
  reason      String
  requestedAt DateTime  @default(now()) @map("requested_at") @db.Timestamptz(3)
  doneAt      DateTime? @map("done_at") @db.Timestamptz(3)

  @@index([doneAt])
  @@map("erasure_tasks")
}
