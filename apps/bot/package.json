{
  "name": "@mvp/bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.mjs",
    "build": "esbuild src/main.ts --bundle --platform=node --target=node22 --format=esm --external:@node-rs/argon2 --outfile=dist/main.mjs --sourcemap --banner:js=\"import { createRequire as __cr } from 'node:module'; const require = __cr(import.meta.url);\""
  },
  "dependencies": {
    "@mvp/channel": "workspace:*",
    "@mvp/conversation": "workspace:*",
    "@mvp/crm": "workspace:*",
    "@mvp/db": "workspace:*",
    "@mvp/llm": "workspace:*",
    "@mvp/parsers": "workspace:*",
    "@mvp/presentation": "workspace:*",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  }
}
